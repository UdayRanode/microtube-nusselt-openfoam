FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "500";
    object      rho;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -3 0 0 0 0 0];

internalField   uniform 997;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 997;
    }
    outlet
    {
        type            calculated;
        value           uniform 997;
    }
    wall
    {
        type            calculated;
        value           uniform 997;
    }
}


